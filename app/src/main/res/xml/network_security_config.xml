<?xml version="1.0" encoding="utf-8"?>
<!-- Radio FM suona gli stream della directory radio-browser.info, che per le
     stazioni italiane (Rai, Radio 24, Virgin, RMC, RTL…) sono quasi sempre
     pubblicati in HTTP semplice e su host diversi per ogni emittente: un
     elenco di domini permessi non può coprirli. Il cleartext resta quindi
     permesso a livello applicazione; ogni endpoint HTTPS continua a validare
     il certificato come prima. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
